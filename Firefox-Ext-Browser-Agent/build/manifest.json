{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "1.0.11",
  "description": "Browser Agent extension for the browser-agent control plane (HTTP poll / temporary or signed install)",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-agent@xhd2015"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Agent"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "http://127.0.0.1:43761/*",
    "http://localhost:43761/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "js": [
        "contentScript.js"
      ],
      "matches": [
        "<all_urls>",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_start"
    }
  ]
}

.vscode
.idea
.codex
.cursor

.config

*.har
node_modules
dist
/external
**/.xgo/gen

# Generated //go:embed payloads (stage via script/*/bundle or install).
# Only placeholder.txt is tracked so go install / module zip stay incomplete
# and runtime hydrate can download release assets (docs/assets-hydrate.md).
browseragent/embedded/extension/**
!browseragent/embedded/extension/placeholder.txt
browseragent/embedded/session-page/**
!browseragent/embedded/session-page/placeholder.txt
browsertrace/embedded/extension/**
!browsertrace/embedded/extension/placeholder.txt

# Firefox AMO API secrets (typo filename is intentional)
.firefox-secretes.txt

# GitHub release upload token (script/github/release)
.upload-credentials.json

# Multi-platform binaries left by script/github/release (cwd build)
/browser-agent-v*-darwin-*
/browser-agent-v*-linux-*

# Signed Firefox .xpi embed (staged by firefox/sign or install). Keep placeholder
# so //go:embed compiles on clean clones without AMO credentials.
browseragent/embedded/firefox-xpi/**
!browseragent/embedded/firefox-xpi/placeholder.txt

dist/

